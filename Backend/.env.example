# ---------- Server ----------
PORT=8000
NODE_ENV=development            # development | production

# ---------- Database / cache ----------
# MongoDB must run as a replica set (Atlas does; local: see docker-compose.yml) because
# invoices are created inside transactions.
MONGODB_URI=mongodb://localhost:27017/invoice-db?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# ---------- CORS / CSRF ----------
# Exact origin(s) of the frontend, comma separated, no trailing slash.
CLIENT_URL=http://localhost:5173

# ---------- JWT (use two DIFFERENT long random strings) ----------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=15d

# ---------- Email (Brevo) ----------
BREVO_API_KEY=
# Verified sender address in your Brevo account
EMAIL_USER=

# ---------- Google login (optional; login with Google is disabled when empty) ----------
GOOGLE_CLIENT_ID=

# ---------- PDF cache encryption ----------
# Exactly 64 hex characters (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CACHE_ENCRYPTION_KEY=

# ---------- Monitoring (optional) ----------
SENTRY_DSN=
# /api/v1/metrics is disabled until BOTH are set
METRICS_USER=
METRICS_PASSWORD=
