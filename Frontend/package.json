{
  "name": "invoicepilot-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "InvoicePilot web app: invoices, customers, products and async email/PDF delivery.",
  "engines": {
    "node": ">=20.19.0"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 16"
  ],
  "scripts": {
    "dev": "vite",
    "dev:mock": "node tools/dev-mock.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check:bundle": "node tools/check-bundle.mjs",
    "contrast": "node tools/contrast.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/figtree": "^5.2.0",
    "@hookform/resolvers": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.12.0",
    "clsx": "2.1.1",
    "lucide-react": "^0.545.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.65.0",
    "react-is": "19.2.8",
    "react-router": "^7.9.0",
    "recharts": "^3.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
