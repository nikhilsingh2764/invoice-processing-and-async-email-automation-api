# Everything prefixed VITE_ is PUBLIC and ships inside the browser bundle.
# Never put a secret in a VITE_ variable.

# API base URL, including /api/v1.
# Default "/api/v1" = same-origin mode: the dev server (vite.config.js) and the
# host (vercel.json / public/_redirects) proxy /api to the backend, so the
# auth cookies are first-party and CORS does not matter.
# Direct mode example: https://api.example.com/api/v1  (then set the backend
# CLIENT_URL to this site's exact origin, and add the API origin to the
# connect-src directive of the CSP; see README).
VITE_API_BASE_URL=/api/v1

# Dev proxy target (used by `npm run dev` and `npm run preview`).
VITE_PROXY_TARGET=http://localhost:8000

# Google Identity Services client id. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=

# Direct mode only: set to true after the backend CORS allowedHeaders includes
# X-Requested-With. In same-origin mode the header is always sent.
VITE_CSRF_HEADER=false
