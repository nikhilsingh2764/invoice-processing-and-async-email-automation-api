# Base URL of the backend API INCLUDING the /api/v1 prefix (no trailing slash needed).
# Example (local):      http://localhost:8000/api/v1
# Example (production): https://your-backend.example.com/api/v1
VITE_API_BASE_URL=

# OPTIONAL. Public Google OAuth Web Client ID (same value as the backend GOOGLE_CLIENT_ID).
# Leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=