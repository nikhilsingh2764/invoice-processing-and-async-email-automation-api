# Base URL of your running backend's API (Backend/src/app.js mounts all
# routes under /api/v1). Do NOT include a trailing slash.
# Example (local dev): http://localhost:8000/api/v1


VITE_API_URL=https://invoice-backend-drqr.onrender.com/api/v1

# Google OAuth client ID, only required if you use the "Continue with
# Google" button (Backend/src/controller/auth/googleAuth.controller.js).
# Leave blank to disable Google sign-in in the UI.
VITE_GOOGLE_CLIENT_ID=
